ENV=production
DEFAULT_SECRET_KEY=your_secret

DOWNLOAD_DIR=/app/downloads
MAX_FILE_AGE_HOURS=2
RATE_LIMIT_PER_MINUTE=20
FFMPEG_BIN=ffmpeg
# Optional: path to a Netscape cookies.txt file to bypass YouTube bot detection
COOKIES_FILE=/app/cookies.txt
# Optional: user agent of the browser that exported the cookies.txt (prevents cookie invalidation)
USER_AGENT=""

HOST=0.0.0.0
PORT=3000
WORKERS=4
DEBUG=false
# Replace with your actual domain(s)
ALLOWED_ORIGINS=["your_domain"]
